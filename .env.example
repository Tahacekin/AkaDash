PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-long-random-string

# Google Cloud Console → OAuth 2.0 Client (Web application)
# The OAuth consent screen must enable the following scopes:
#   openid, email, profile, https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI on the Google Cloud OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Default Moodle base URL used when a user does not override it when connecting.
MOODLE_DEFAULT_BASE_URL=https://mylms.atlas.edu.tr

NODE_ENV=development
